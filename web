<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thời Trang & Phụ Kiện Gen Z - Flash Sale</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    html { scroll-behavior: smooth; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased pb-20 md:pb-0">

  <!-- 1. ĐỒNG HỒ ĐẾM NGƯỢC TẠO SỰ CẤP BÁCH (TOP BAR STICKY) -->
  <div class="bg-rose-950 text-white py-2 px-3 sticky top-0 z-40 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-row items-center justify-center gap-2 text-xs font-medium text-center">
      <span class="flex items-center gap-1.5 text-amber-400 font-semibold whitespace-nowrap">
        <i class="fa-solid fa-fire animate-bounce"></i>
        FLASH SALE GEN Z!
      </span>
      <p class="text-rose-100 text-xs">
        Đồng giá từ 99k kết thúc sau: 
        <span id="countdown" class="font-mono font-bold text-rose-400 bg-rose-900/80 px-2 py-0.5 rounded border border-rose-700/50 ml-0.5">
          15:00
        </span>
      </p>
    </div>
  </div>

  <!-- HERO SECTION & SOCIAL PROOF -->
  <section class="relative overflow-hidden pt-6 pb-12 md:pt-16 md:pb-24">
    <!-- Background Glow Effect -->
    <div class="absolute -top-20 -right-20 w-72 h-72 md:w-96 md:h-96 bg-rose-200/50 rounded-full blur-3xl -z-10 pointer-events-none"></div>
    <div class="absolute top-1/2 -left-20 w-60 h-60 md:w-80 md:h-80 bg-rose-100/60 rounded-full blur-3xl -z-10 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
        
        <!-- CỘT TRÁI: Nội dung chính -->
        <div class="lg:col-span-7 space-y-4 md:space-y-6 text-center lg:text-left">
          
          <!-- Badge Hot Sale -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-100 border border-rose-200 text-rose-800 text-xs font-semibold tracking-wide uppercase shadow-sm">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-600"></span>
            </span>
            <i class="fa-solid fa-bolt text-rose-600"></i>
            HOT TREND GEN Z — GIÁ CHỈ TỪ 99K
          </div>

          <!-- Tiêu đề (Chuẩn Mobile: max 24px trên điện thoại) -->
          <h1 class="text-[22px] sm:text-[24px] md:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-snug">
            Outfit Đỉnh Cao <br class="hidden sm:inline">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-600 to-amber-600">
              Cân Mọi Style Phố Pường
            </span>
          </h1>

          <!-- Phụ đề ngắn -->
          <p class="text-sm md:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            Bộ sưu tập Baby Tee, Áo Boxy, Quần Parachute, Sneaker & Dép Bánh Mì cực cuốn. Phối sẵn nguyên Set chuẩn gu Gen Z chỉ từ 100k - 400k.
          </p>

          <!-- Nút CTA Desktop/Tablet -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <a href="#order-form" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-base md:text-lg font-bold text-white bg-rose-600 hover:bg-rose-700 active:bg-rose-800 rounded-xl shadow-lg shadow-rose-600/30 transition-all duration-200">
              <i class="fa-solid fa-bag-shopping"></i>
              Săn Deal Ngay
            </a>
            <span class="text-xs text-slate-500 flex items-center gap-1">
              <i class="fa-solid fa-truck-fast text-rose-600"></i> Đồng kiểm khi nhận • Đổi trả 7 ngày
            </span>
          </div>

          <!-- Khối Social Proof -->
          <div class="pt-4 md:pt-6 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
            <div class="flex -space-x-2.5 overflow-hidden">
              <img class="inline-block h-8 w-8 md:h-10 md:w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="Khách 1">
              <img class="inline-block h-8 w-8 md:h-10 md:w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=100&q=80" alt="Khách 2">
              <img class="inline-block h-8 w-8 md:h-10 md:w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80" alt="Khách 3">
              <img class="inline-block h-8 w-8 md:h-10 md:w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=100&q=80" alt="Khách 4">
            </div>

            <div class="text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start gap-1 text-amber-400">
                <i class="fa-solid fa-star text-xs"></i>
                <i class="fa-solid fa-star text-xs"></i>
                <i class="fa-solid fa-star text-xs"></i>
                <i class="fa-solid fa-star text-xs"></i>
                <i class="fa-solid fa-star text-xs"></i>
                <span class="ml-1 text-xs font-bold text-slate-800">5.0 / 5.0</span>
              </div>
              <p class="text-xs text-slate-600 mt-0.5">
                Hơn <strong class="text-slate-900 font-semibold">1.000+ tín đồ Gen Z</strong> đã săn đợt này
              </p>
            </div>
          </div>

        </div>

        <!-- CỘT PHẢI: Hình ảnh sản phẩm (Thời trang Gen Z) -->
        <div class="lg:col-span-5 relative flex justify-center">
          <div class="relative w-full max-w-sm lg:max-w-none">
            <div class="absolute inset-0 bg-gradient-to-tr from-rose-500 to-amber-300 rounded-2xl transform rotate-2 scale-95 opacity-20 blur-md"></div>
            
            <div class="relative bg-white p-3 md:p-4 rounded-2xl shadow-xl border border-slate-100">
              <img 
                src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=800&q=80" 
                alt="Thời trang Quần áo Giày dép Gen Z" 
                class="w-full h-72 sm:h-96 object-cover rounded-xl"
              >
              
              <div class="absolute top-6 right-6 bg-slate-900/80 backdrop-blur-md text-white px-2.5 py-1 rounded-lg text-[10px] md:text-xs font-medium flex items-center gap-1 shadow-md">
                <i class="fa-solid fa-sparkles text-amber-400"></i>
                <span>Trọn bộ Set Outfit</span>
              </div>

              <!-- Floating Price Card -->
              <div class="absolute -bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-3 rounded-xl shadow-lg border border-slate-100 flex items-center justify-between">
                <div>
                  <p class="text-[10px] text-slate-400 line-through font-medium">500.000đ</p>
                  <p class="text-base md:text-xl font-extrabold text-rose-600">Từ 99k - 399k</p>
                </div>
                <span class="bg-rose-600 text-white text-[10px] md:text-xs font-bold px-2 py-0.5 rounded">
                  GIẢM 40%
                </span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. FORM ĐẶT HÀNG (DẠNG 1 CỘT TRÊN MOBILE) -->
  <section id="order-form" class="py-10 md:py-16 bg-slate-100 border-t border-slate-200">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <div class="bg-white rounded-2xl md:rounded-3xl p-5 md:p-10 shadow-lg border border-slate-100">
        
        <div class="text-center mb-6">
          <h2 class="text-xl md:text-3xl font-extrabold text-slate-900">
            Thông Tin Đặt Hàng
          </h2>
          <p class="text-xs md:text-sm text-slate-500 mt-1">
            Điền thông tin để shop giữ Slot ưu đãi giảm giá và tư vấn Size nhé!
          </p>
        </div>

        <form id="checkoutForm" class="space-y-4" onsubmit="handleOrderSubmit(event)">
          <!-- Họ tên -->
          <div>
            <label for="fullName" class="block text-xs md:text-sm font-semibold text-slate-700 mb-1">
              Họ và tên <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-regular fa-user"></i>
              </span>
              <input 
                type="text" 
                id="fullName" 
                required 
                placeholder="Nguyễn Văn A" 
                class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 text-xs md:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
              >
            </div>
          </div>

          <!-- Số điện thoại -->
          <div>
            <label for="phoneNumber" class="block text-xs md:text-sm font-semibold text-slate-700 mb-1">
              Số điện thoại <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-phone"></i>
              </span>
              <input 
                type="tel" 
                id="phoneNumber" 
                required 
                pattern="[0-9]{10,11}"
                placeholder="0912345678" 
                class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 text-xs md:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
              >
            </div>
          </div>

          <!-- Địa chỉ -->
          <div>
            <label for="address" class="block text-xs md:text-sm font-semibold text-slate-700 mb-1">
              Địa chỉ nhận hàng <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">
                <i class="fa-solid fa-location-dot"></i>
              </span>
              <input 
                type="text" 
                id="address" 
                required 
                placeholder="Số nhà, đường, quận/huyện, tỉnh/TP" 
                class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-slate-900 text-xs md:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent"
              >
            </div>
          </div>

          <!-- Nút Submit Form -->
          <button 
            type="submit" 
            class="w-full py-3.5 px-4 text-base md:text-lg font-bold text-white bg-rose-600 hover:bg-rose-700 active:bg-rose-800 rounded-xl shadow-md transition-all duration-200 flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-bag-shopping"></i>
            MUA NGAY - GIẢM 30%
          </button>
        </form>

      </div>
    </div>
  </section>

  <!-- 3. STICKY CTA CỐ ĐỊNH Ở ĐÁY MÀN HÌNH ĐIỆN THOẠI (MD:HIDDEN) -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 shadow-2xl md:hidden">
    <div class="flex items-center justify-between gap-3 max-w-md mx-auto">
      <div>
        <span class="text-[10px] text-slate-400 line-through">500.000đ</span>
        <p class="text-base font-extrabold text-rose-600 leading-tight">Từ 99k - 399k</p>
      </div>
      <a 
        href="#order-form" 
        class="flex-1 py-3 px-4 bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white font-bold text-sm text-center rounded-xl shadow-md flex items-center justify-center gap-1.5 transition-all"
      >
        <i class="fa-solid fa-bag-shopping"></i>
        Đặt hàng ngay
      </a>
    </div>
  </div>

  <!-- MODAL CHÚC MỪNG -->
  <div id="successModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-2xl p-6 md:p-8 max-w-sm w-full shadow-2xl border border-slate-100 text-center transform scale-95 transition-transform duration-300">
      <div class="w-12 h-12 md:w-16 md:h-16 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-3 text-xl md:text-2xl">
        <i class="fa-solid fa-check"></i>
      </div>

      <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mb-2">Đặt Hàng Thành Công!</h3>
      <p id="modalMessage" class="text-xs md:text-sm text-slate-600 mb-5 leading-relaxed">
        <!-- JS điền thông tin động -->
      </p>

      <button 
        onclick="closeModal()" 
        class="w-full py-2.5 px-4 text-xs md:text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow transition-all"
      >
        Đóng
      </button>
    </div>
  </div>

  <!-- JAVASCRIPT XỬ LÝ -->
  <script>
    // 1. ĐỒNG HỒ ĐẾM NGƯỢC 15 PHÚT
    let timeInSeconds = 15 * 60;
    const countdownEl = document.getElementById('countdown');

    const timer = setInterval(() => {
      const minutes = Math.floor(timeInSeconds / 60);
      const seconds = timeInSeconds % 60;
      countdownEl.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

      if (timeInSeconds <= 0) {
        clearInterval(timer);
        countdownEl.textContent = "00:00";
      } else {
        timeInSeconds--;
      }
    }, 1000);

    // 2. GỬI FORM & HIỂN THỊ MODAL
    const modal = document.getElementById('successModal');
    const modalMsg = document.getElementById('modalMessage');
    const orderForm = document.getElementById('checkoutForm');

    function handleOrderSubmit(event) {
      event.preventDefault();

      const nameInput = document.getElementById('fullName');
      const customerName = nameInput.value.trim();

      modalMsg.textContent = `Cảm ơn ${customerName}! Đơn hàng đã được ghi nhận. Shop sẽ gọi tư vấn Size & gửi hàng ngay nhé!`;

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.querySelector('div').classList.remove('scale-95');
      }, 10);

      orderForm.reset();
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      modal.querySelector('div').classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }
  </script>

</body>
</html>
